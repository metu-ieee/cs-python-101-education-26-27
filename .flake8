[flake8]
max-line-length = 88
extend-ignore = 
    # F403: 'from module import *' used; unable to detect undefined names
    F403,
    # F405: name may be undefined, or defined from star imports
    F405,
    # E203: Whitespace before ':' (Required to not conflict with Black)
    E203
exclude =
    .git,
    __pycache__,
    venv,
    *.ipynb,
    .ipynb_checkpoints