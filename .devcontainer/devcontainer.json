{
  "name": "METU IEEE CS+AESS Python Environment",
  
  "image": "mcr.microsoft.com/devcontainers/python:3",

  "customizations": {
    "vscode": {
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "black-formatter.args": ["--line-length", "88"]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-toolsai.jupyter"
      ]
    }
  },
  
  "postCreateCommand": "pip install ipykernel && echo 'echo \"Welcome to the CS+AESS Python 101 Cloud Environment!\"' >> ~/.bashrc"
}
